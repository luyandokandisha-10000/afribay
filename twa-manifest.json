{
  "packageId": "com.afribay.app",
  "host": "afribay.com",
  "name": "AfriBay",
  "launcherName": "AfriBay",
  "themeColor": "#123024",
  "navigationColor": "#123024",
  "navigationColorDark": "#101a15",
  "navigationDividerColor": "#00000000",
  "navigationDividerColorDark": "#00000000",
  "backgroundColor": "#fbfcfa",
  "enableNotifications": true,
  "startUrl": "/",
  "iconUrl": "https://afribay.com/icons/icon-512.png",
