  "appVersionName": "1.0.0",
  "appVersionCode": 1,
  "signing": {
    "file": "./afribay-release-key.keystore",
    "alias": "afribay"
  },
  "splashScreenFadeOutDuration": 300,
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "features": {
    "playBilling": {
      "enabled": false
    }
  },
  "alphaDependencies": {
    "enabled": false
