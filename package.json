{
  "name": "afribay-marketplace",
  "version": "1.0.0",
  "description": "AfriBay — Zambian Marketplace, Mobile Money Escrow & Video Feed Platform",
  "type": "module",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "dev:server": "node --watch server/app.js",
    "build": "node -e \"console.log('AfriBay web assets verified')\"",
    "serve": "npx serve .",
    "playstore:bubblewrap": "npx @bubblewrap/cli build",
    "playstore:init": "npx @bubblewrap/cli init --manifest=manifest.json",
    "cap:sync": "npx @capacitor/cli sync",
    "cap:android": "npx @capacitor/cli open android",
    "test": "node --check server/app.js && node --check src/firestore.js"
  },
  "keywords": [
    "marketplace",
    "zambia",
    "escrow",
    "mobile-money",
    "pwa",
    "twa",
    "google-play-store"
  ],
  "author": "AfriBay Team",
  "license": "ISC",
  "dependencies": {
    "flutterwave-react-v3": "^1.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
